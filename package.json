{
  "name": "veloroute",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "npm run dev --workspace=@veloroute/web",
    "lint": "turbo lint",
    "db:generate": "npm run generate --workspace=@veloroute/db",
    "db:migrate": "npm run migrate --workspace=@veloroute/db",
    "db:push": "npm run db:push --workspace=@veloroute/db",
    "db:seed": "npm run seed --workspace=@veloroute/db"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "turbo": "^2.3.3"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=20"
  }
}
