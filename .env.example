# =============================================================================
# Shared (local + optional tooling)
# =============================================================================

# PostgreSQL (required for API + Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/veloroute?schema=public"

# Optional: Redis for horizontal Socket.io scaling (API)
REDIS_URL="redis://localhost:6379"

# Transactional email (Resend) — used by apps/web /api/send-email
RESEND_API_KEY=""
RESEND_FROM="Nexship Logistics <support@nexships.com>"
# Inbox for admin/CC copies of shipment, quote, and contact emails
ADMIN_EMAIL="support@nexships.com"

# Seed (packages/db prisma seed)
SEED_ADMIN_EMAIL="admin@veloroute.local"
SEED_ADMIN_PASSWORD="adminadmin12"

# =============================================================================
# API only — apps/api (or Railway / Render / Fly / VM). Not injected into Vercel web.
# =============================================================================

PORT=3001
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# =============================================================================
# Web — apps/web (local)
# =============================================================================

# Supabase auth (required when using Supabase login in the web app)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Split local dev: point at API. Merged local dev: omit both so the UI uses same-origin /api/v1 and WS on that host.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Optional: server-side fetch when UI and API share one Node process (npm run dev:merged). Merged server sets this from PORT if unset.
# INTERNAL_API_URL="http://127.0.0.1:3000/api/v1"

# =============================================================================
# Vercel — Project: Next.js app (set Root Directory to `apps/web` in dashboard)
# =============================================================================
#
# Required for production (browser + Socket.io to your deployed API):
#   NEXT_PUBLIC_API_URL=https://YOUR_API_HOST/api/v1
#   NEXT_PUBLIC_WS_URL=https://YOUR_API_HOST
#
# Mapbox (optional):
#   NEXT_PUBLIC_MAPBOX_TOKEN=
#
# Same-origin /api/v1 proxy only (optional): if the browser must call relative /api/v1
# but you do not want to bake the API URL into the client bundle, set this server-side
# rewrite target at build time (Vercel → Environment Variables):
#   API_REWRITE_BASE_URL=https://YOUR_API_HOST/api/v1
#
# Server Components / RSC calling the API: prefer NEXT_PUBLIC_API_URL, or set:
#   INTERNAL_API_URL=https://YOUR_API_HOST/api/v1
#
# Vercel does NOT run the Fastify API or long-lived Socket.io by default. Deploy
# apps/api (or use npm run start:merged) on a Node host with DATABASE_URL + JWT_*.
